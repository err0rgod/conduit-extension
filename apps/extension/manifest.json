{
  "manifest_version": 3,
  "name": "Conduit Extension",
  "version": "0.1.0",
  "description": "Secure local-first browser control for AI agents.",
  "key": "",
  "permissions": ["activeTab", "tabs", "tabGroups", "scripting", "storage", "nativeMessaging"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["debugger", "downloads"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conduit"
  }
}
