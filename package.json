{
  "name": "conduit-extension-repository",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "extension:build": "pnpm --filter @conduit/extension build",
    "extension:package": "pnpm --filter @conduit/extension package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --workspace vitest.workspace.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "esbuild": "0.21.5",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
